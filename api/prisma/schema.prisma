// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Catalogue (v1) — proposition de schéma, à valider/ajuster avec ESOF.
// ---------------------------------------------------------------------------

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  logoUrl   String?   @map("logo_url")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]
  gammes    Gamme[]

  @@map("brands")
}

/// Ligne de produits d'une marque (ex. Legrand -> Céliane/Dooxie/Mosaic).
/// Toujours rattachée à une marque (relation obligatoire) ; toujours
/// facultative côté Product — voir Product.gammeId.
model Gamme {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  imageUrl    String? @map("image_url")
  displayOrder Int    @default(0) @map("display_order")

  brandId String @map("brand_id") @db.Uuid
  brand   Brand  @relation(fields: [brandId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@unique([brandId, name])
  @@map("gammes")
}

model Category {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  imageUrl     String?    @map("image_url")
  isActive     Boolean    @default(true) @map("is_active")
  displayOrder Int        @default(0) @map("display_order")
  parentId     String?    @map("parent_id") @db.Uuid
  parent       Category?  @relation("CategoryToParent", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryToParent")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]
  subcategories Subcategory[]

  @@map("categories")
}

/// Affine la classification d'un produit au sein d'une catégorie
/// (ex. catégorie "Interrupteurs" -> sous-catégories "Simple", "Double"...).
/// Toujours facultative côté Product — voir Product.subcategoryId.
model Subcategory {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  imageUrl    String? @map("image_url")
  displayOrder Int    @default(0) @map("display_order")

  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@unique([categoryId, name])
  @@map("subcategories")
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  reference    String?  @unique @db.VarChar(30)
  description  String?
  price        Decimal? @db.Decimal(12, 2)
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")

  /// Mise en avant (page d'accueil mobile/TV) — voir Partie A du brief
  /// "Marques statiques + Produits mis en avant".
  isNew       Boolean  @default(false) @map("is_new")
  onPromotion Boolean  @default(false) @map("on_promotion")
  promoPrice  Decimal? @map("promo_price") @db.Decimal(12, 2)
  onSale      Boolean  @default(false) @map("on_sale")
  salePrice   Decimal? @map("sale_price") @db.Decimal(12, 2)

  /// Stock (gestion interne, non liée au prix) — remplace l'affichage du
  /// prix côté public par un badge de disponibilité (voir catalog.service.ts
  /// `toPublicProduct`). `quantiteStock` : quantité en stock, gérée par
  /// l'admin. `afficherQuantite` : si vrai, la quantité exacte est exposée
  /// aux apps publiques en plus du badge Disponible/Épuisé ; sinon seul le
  /// badge est renvoyé.
  quantiteStock    Int     @default(0) @map("quantite_stock")
  afficherQuantite Boolean @default(false) @map("afficher_quantite")

  brandId    String?  @map("brand_id") @db.Uuid
  brand      Brand?   @relation(fields: [brandId], references: [id])
  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])

  subcategoryId String?      @map("subcategory_id") @db.Uuid
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  gammeId String? @map("gamme_id") @db.Uuid
  gamme   Gamme?  @relation(fields: [gammeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  specs          ProductSpec[]
  images         ProductImage[]
  quoteItems     QuoteItem[]
  ligneCommandes LigneCommande[]

  @@map("products")
}

/// Caractéristique technique libre (clé/valeur), ex. "Puissance" / "60W".
/// Sert aussi de source pour le menu de navigation "Caractéristiques".
model ProductSpec {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String

  @@map("product_specs")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int     @default(0)

  @@map("product_images")
}

/// Vidéos publicitaires diffusées en boucle en mode ordinaire (app TV).
model PromoVideo {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  url       String
  position  Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("promo_videos")
}

// ---------------------------------------------------------------------------
// Comptes internes, clients, devis (v2)
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  COMMERCIAL
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")

  clientsCreated Client[]     @relation("ClientCreatedBy")
  clientNotes    ClientNote[]
  quotes         Quote[]

  @@map("users")
}

model Client {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String
  email     String?
  company   String?
  createdBy String   @map("created_by") @db.Uuid
  creator   User     @relation("ClientCreatedBy", fields: [createdBy], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  notes  ClientNote[]
  quotes Quote[]

  @@map("clients")
}

model ClientNote {
  id           String   @id @default(uuid()) @db.Uuid
  clientId     String   @map("client_id") @db.Uuid
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  commercialId String   @map("commercial_id") @db.Uuid
  commercial   User     @relation(fields: [commercialId], references: [id])
  note         String
  visitDate    DateTime @map("visit_date")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("client_notes")
}

enum QuoteStatus {
  DRAFT
  SENT
}

model Quote {
  id           String      @id @default(uuid()) @db.Uuid
  clientId     String      @map("client_id") @db.Uuid
  client       Client      @relation(fields: [clientId], references: [id])
  commercialId String      @map("commercial_id") @db.Uuid
  commercial   User        @relation(fields: [commercialId], references: [id])
  status       QuoteStatus @default(DRAFT)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  items QuoteItem[]

  @@map("quotes")
}

model QuoteItem {
  id        String  @id @default(uuid()) @db.Uuid
  quoteId   String  @map("quote_id") @db.Uuid
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  note      String?

  @@map("quote_items")
}

// ---------------------------------------------------------------------------
// Espace des Pros — professionnels, agents commerciaux ESOF (contacts
// WhatsApp), commandes passées par les Pros (v3).
// ---------------------------------------------------------------------------

/// Compte "Pro" (revendeur, électricien, entreprise de construction...) :
/// authentification par identifiant/mot de passe (hash bcrypt), distincte du
/// modèle User (comptes internes admin/commercial ESOF de l'Espace commercial).
model Professionnel {
  id          String   @id @default(uuid()) @db.Uuid
  nom         String   @db.VarChar(150)
  identifiant String   @unique @db.VarChar(50)
  motDePasse  String   @map("mot_de_passe") @db.VarChar(255)
  telephone1  String   @map("telephone_1") @db.VarChar(20)
  telephone2  String?  @map("telephone_2") @db.VarChar(20)
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  commandes Commande[]

  @@map("professionnels")
}

/// Contact commercial ESOF (nom/prénom/téléphone WhatsApp) destinataire des
/// commandes envoyées par les Pros. Sans rapport avec Role.COMMERCIAL /
/// User (Espace commercial) — nommé distinctement pour éviter la confusion.
/// `identifiant`/`motDePasse` (rubrique "Traitement") sont nullable : les
/// commerciaux existants n'en ont pas encore tant qu'un admin ne les leur
/// attribue pas via l'interface admin.
model AgentCommercial {
  id          String   @id @default(uuid()) @db.Uuid
  nom         String   @db.VarChar(100)
  prenom      String   @db.VarChar(100)
  telephone1  String   @map("telephone_1") @db.VarChar(20)
  telephone2  String?  @map("telephone_2") @db.VarChar(20)
  identifiant String?  @unique @db.VarChar(50)
  motDePasse  String?  @map("mot_de_passe") @db.VarChar(255)
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  commandes Commande[]

  @@map("agents_commerciaux")
}

model Commande {
  id              String          @id @default(uuid()) @db.Uuid
  professionnelId String          @map("professionnel_id") @db.Uuid
  professionnel   Professionnel   @relation(fields: [professionnelId], references: [id])
  commercialId    String          @map("commercial_id") @db.Uuid
  commercial      AgentCommercial @relation(fields: [commercialId], references: [id])
  dateCommande    DateTime        @default(now()) @map("date_commande")
  /// ENVOYEE (défaut) | EN_TRAITEMENT | PROFORMA_EMISE | MODIFIEE | ANNULEE
  /// — voir CommandesService pour les transitions valides.
  statut String @default("ENVOYEE") @db.VarChar(30)

  /// Motif renseigné par le commercial en cas d'annulation (§Traitement).
  motifAnnulation String? @map("motif_annulation")
  /// Coché par le commercial lors du traitement des prix (facture proforma).
  tvaApplicable Boolean @default(false) @map("tva_applicable")
  /// BIC 2 % (Bénéfice Industriel et Commercial, Burkina Faso) — optionnel,
  /// calculé sur le montant TTC (ou HT si la TVA n'est pas appliquée).
  bicApplicable Boolean @default(false) @map("bic_applicable")
  /// Numéro séquentiel annuel de la facture proforma, format PF-AAAA-XXXX.
  numeroProforma String?   @unique @map("numero_proforma") @db.VarChar(20)
  dateProforma   DateTime? @map("date_proforma")

  lignes     LigneCommande[]
  historique HistoriqueCommande[]

  @@map("commandes")
}

model LigneCommande {
  id             String   @id @default(uuid()) @db.Uuid
  commandeId     String   @map("commande_id") @db.Uuid
  commande       Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  produitId      String   @map("produit_id") @db.Uuid
  produit        Product  @relation(fields: [produitId], references: [id])
  quantite       Int
  libelleProduit String   @map("libelle_produit") @db.VarChar(255)
  /// Prix unitaire en FCFA (sans décimales), renseigné par le commercial
  /// lors du traitement — nul tant qu'il n'a pas encore été saisi.
  prixUnitaire Decimal? @map("prix_unitaire") @db.Decimal(12, 0)

  @@map("lignes_commande")
}

/// Journal des actions du commercial sur une commande (rubrique
/// "Traitement") — écriture automatique par CommandesService, jamais
/// modifiable depuis l'app. `action` : PRISE_EN_CHARGE | MODIFICATION |
/// PRIX_RENSEIGNES | PROFORMA_EMISE | ANNULATION.
model HistoriqueCommande {
  id         String   @id @default(uuid()) @db.Uuid
  commandeId String   @map("commande_id") @db.Uuid
  commande   Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  dateAction DateTime @default(now()) @map("date_action")
  action     String   @db.VarChar(30)
  details    String?

  @@map("historique_commandes")
}
